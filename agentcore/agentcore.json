{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "CustomerSupportAgent",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "CustomerSupportAgent"
  },
  "runtimes": [
    {
      "name": "CustomerSupportAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/CustomerSupportAgent/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP"
    }
  ],
  "memories": [
    {
      "name": "CustomerSupportMemory",
      "eventExpiryDuration": 30,
      "strategies": [
        {
          "type": "SEMANTIC",
          "namespaceTemplates": ["/users/{actorId}/facts"]
        },
        {
          "type": "USER_PREFERENCE",
          "namespaceTemplates": ["/users/{actorId}/preferences"]
        }
      ]
    }
  ],
  "knowledgeBases": [
    {
      "type": "AgentCoreKnowledgeBase",
      "name": "CustomerSupportKB",
      "dataSources": [
        {
          "type": "S3",
          "uri": "s3://customer-support-<ACCOUNT_ID>-<REGION>-an/product_catalog.txt"
        }
      ]
    }
  ],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "CustomerSupportGateway",
      "protocolType": "None",
      "description": "Gateway for CustomerSupportGateway",
      "targets": [
        {
          "name": "order-tracker",
          "targetType": "apiGateway",
          "apiGateway": {
            "restApiId": "<API_GATEWAY_REST_API_ID>",
            "stage": "prod",
            "apiGatewayToolConfiguration": {
              "toolFilters": [
                {
                  "filterPath": "/*",
                  "methods": ["GET"]
                }
              ]
            }
          }
        },
        {
          "name": "refund-processor",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "arn:aws:lambda:<REGION>:<ACCOUNT_ID>:function:refund-processor",
            "toolSchemaFile": "lambda-src/lambda_schema"
          }
        },
        {
          "name": "product-catalog-kb",
          "targetType": "connector",
          "connectorId": "bedrock-knowledge-bases",
          "configurations": [
            {
              "name": "AgenticRetrieveStream",
              "description": "Streaming endpoint for agentic retrieval from knowledge bases. Performs multi-step retrieval with planning and returns results as a stream of events.",
              "parameterValues": {
                "retrievers": [
                  {
                    "configuration": {
                      "knowledgeBase": {
                        "knowledgeBaseId": "<KNOWLEDGE_BASE_ID>"
                      }
                    }
                  }
                ],
                "agenticRetrieveConfiguration": {
                  "foundationModelType": "MANAGED",
                  "rerankingModelType": "MANAGED"
                }
              },
              "parameterOverrides": []
            },
            {
              "name": "Retrieve",
              "description": "Search the product catalog and customer support knowledge base. Use this for questions about product specifications, return policies, warranty terms, loyalty program tier benefits (Silver/Gold/Platinum), shipping details, and other store policy information.",
              "parameterValues": {
                "knowledgeBaseId": "<KNOWLEDGE_BASE_ID>"
              },
              "parameterOverrides": []
            }
          ]
        }
      ],
      "authorizerType": "NONE",
      "enableSemanticSearch": false,
      "exceptionLevel": "NONE"
    }
  ],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}
